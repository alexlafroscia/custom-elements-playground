{
  // Shared by the `tsconfig.json` of each fixture, which compiles its expected
  // output alongside a registration of its elements in `HTMLElementTagNameMap`;
  // used by `types.test.ts`, and by editors to check fixtures in the same way
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": [],
    // The generated file is a declaration file, which must be checked too
    "skipLibCheck": false
  }
}
