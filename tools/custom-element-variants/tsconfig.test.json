{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vitest/browser"],
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,

    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo"
